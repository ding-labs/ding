{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ding-cloud-soak",
  "main": "src/entry.mjs",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {"crons": ["* * * * *"]},
  "r2_buckets": [{"binding": "EVIDENCE", "bucket_name": "ding-cloud-soak-evidence"}],
  "observability": {"enabled": true, "traces": {"enabled": true, "head_sampling_rate": 0.01}},
  "limits": {"cpu_ms": 50}
}
