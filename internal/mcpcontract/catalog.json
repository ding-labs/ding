    {
      "name": "ding_apply_changes",
      "title": "Ding Apply Changes",
      "description": "Apply an authorized, previously reviewed preview. Generate a UUID ONCE for this action; use the same key for retries or reconciliation. The daemon rejects expired or stale previews.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "handle": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "operation_key": {
            "pattern": "^[a-zA-Z0-9_-]{16,128}$",
            "type": "string"
          }
        },
        "required": [
          "handle",
          "operation_key"
        ]
      },
      "outputSchema": {
        "properties": {
          "view": {
